package com.youshangdache.rules

import com.youshangdache.model.form.rules.ProfitsharingRuleRequest;
import java.math.BigDecimal;
import java.math.RoundingMode
import com.youshangdache.model.vo.rules.ProfitsharingRuleResponse;

global com.youshangdache.model.vo.rules.ProfitsharingRuleResponse profitsharingRuleResponse;

/**
 * 分账规则
 *
 * 同 FeeRule.drl：必须用 setXxx() 修改 global 指向的同一个对象，
 * 不能对 global 变量整体重新赋值，否则降低 salience 的规则读不到前面算好的 paymentFee。
 *
 * 执行顺序：100 先算微信通道费 → 50 再按订单金额与当日单量分档算平台抽成与司机个税。
 */

/**
    支付微信平台费用 平台费率：0.6%
*/
rule "支付微信平台费用 平台费率：0.6%"
    salience 100
    no-loop true
    when
        $rule:ProfitsharingRuleRequest()
    then
        profitsharingRuleResponse.setOrderAmount($rule.getOrderAmount());
        profitsharingRuleResponse.setPaymentRate(new BigDecimal("0.006"));
        profitsharingRuleResponse.setPaymentFee(
            $rule.getOrderAmount()
                .multiply(new BigDecimal("0.006"))
                .setScale(2, RoundingMode.HALF_UP)
        );
end

/**
    订单金额小于等于100
        当天完成订单小于等于10单 平台抽成 20%
        当天完成订单大于10单 平台抽成 18%
*/
rule "订单金额小于等于100 当天完成订单小于等于10单"
    salience 50
    no-loop true
    when
        $rule:ProfitsharingRuleRequest(
            orderAmount.compareTo(new BigDecimal("100.0")) <= 0
            && orderNum <= 10
        )
    then
        BigDecimal totalAmount = profitsharingRuleResponse.getOrderAmount()
                                         .subtract(profitsharingRuleResponse.getPaymentFee());
        BigDecimal platformIncome = totalAmount.multiply(new BigDecimal("0.2"))
                                         .setScale(2, RoundingMode.HALF_UP);
        BigDecimal driverTotalIncome = totalAmount.subtract(platformIncome);
        BigDecimal driverTaxFee = driverTotalIncome.multiply(new BigDecimal("0.1"))
                                         .setScale(2, RoundingMode.HALF_UP);
        BigDecimal driverIncome = driverTotalIncome.subtract(driverTaxFee);
        profitsharingRuleResponse.setPlatformIncome(platformIncome);
        profitsharingRuleResponse.setDriverIncome(driverIncome);
        profitsharingRuleResponse.setDriverTaxRate(new BigDecimal("0.1"));
        profitsharingRuleResponse.setDriverTaxFee(driverTaxFee);
end

rule "订单金额小于等于100 当天完成订单大于10单"
    salience 50
    no-loop true
    when
        $rule:ProfitsharingRuleRequest(
            orderAmount.compareTo(new BigDecimal("100.0")) <= 0
            && orderNum > 10
        )
    then
        BigDecimal totalAmount = profitsharingRuleResponse.getOrderAmount()
                                         .subtract(profitsharingRuleResponse.getPaymentFee());
        BigDecimal platformIncome = totalAmount.multiply(new BigDecimal("0.18"))
                                         .setScale(2, RoundingMode.HALF_UP);
        BigDecimal driverTotalIncome = totalAmount.subtract(platformIncome);
        BigDecimal driverTaxFee = driverTotalIncome.multiply(new BigDecimal("0.1"))
                                         .setScale(2, RoundingMode.HALF_UP);
        BigDecimal driverIncome = driverTotalIncome.subtract(driverTaxFee);
        profitsharingRuleResponse.setPlatformIncome(platformIncome);
        profitsharingRuleResponse.setDriverIncome(driverIncome);
        profitsharingRuleResponse.setDriverTaxRate(new BigDecimal("0.1"));
        profitsharingRuleResponse.setDriverTaxFee(driverTaxFee);
end

/**
    订单金额大于100
        当天完成订单小于等于10单 平台抽成 18%
        当天完成订单大于10单 平台抽成 16%
*/
rule "订单金额大于100 当天完成订单小于等于10单"
    salience 50
    no-loop true
    when
        $rule:ProfitsharingRuleRequest(
            orderAmount.compareTo(new BigDecimal("100.0")) > 0
            && orderNum <= 10
        )
    then
        BigDecimal totalAmount = profitsharingRuleResponse.getOrderAmount()
                                         .subtract(profitsharingRuleResponse.getPaymentFee());
        BigDecimal platformIncome = totalAmount.multiply(new BigDecimal("0.18"))
                                         .setScale(2, RoundingMode.HALF_UP);
        BigDecimal driverTotalIncome = totalAmount.subtract(platformIncome);
        BigDecimal driverTaxFee = driverTotalIncome.multiply(new BigDecimal("0.1"))
                                         .setScale(2, RoundingMode.HALF_UP);
        BigDecimal driverIncome = driverTotalIncome.subtract(driverTaxFee);
        profitsharingRuleResponse.setPlatformIncome(platformIncome);
        profitsharingRuleResponse.setDriverIncome(driverIncome);
        profitsharingRuleResponse.setDriverTaxRate(new BigDecimal("0.1"));
        profitsharingRuleResponse.setDriverTaxFee(driverTaxFee);
end

rule "订单金额大于100 当天完成订单大于10单"
    salience 50
    no-loop true
    when
        $rule:ProfitsharingRuleRequest(
            orderAmount.compareTo(new BigDecimal("100.0")) > 0
            && orderNum > 10
        )
    then
        BigDecimal totalAmount = profitsharingRuleResponse.getOrderAmount()
                                         .subtract(profitsharingRuleResponse.getPaymentFee());
        BigDecimal platformIncome = totalAmount.multiply(new BigDecimal("0.16"))
                                         .setScale(2, RoundingMode.HALF_UP);
        BigDecimal driverTotalIncome = totalAmount.subtract(platformIncome);
        BigDecimal driverTaxFee = driverTotalIncome.multiply(new BigDecimal("0.1"))
                                         .setScale(2, RoundingMode.HALF_UP);
        BigDecimal driverIncome = driverTotalIncome.subtract(driverTaxFee);
        profitsharingRuleResponse.setPlatformIncome(platformIncome);
        profitsharingRuleResponse.setDriverIncome(driverIncome);
        profitsharingRuleResponse.setDriverTaxRate(new BigDecimal("0.1"));
        profitsharingRuleResponse.setDriverTaxFee(driverTaxFee);
end

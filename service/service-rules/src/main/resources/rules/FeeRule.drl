package com.youshangdache.rules

import com.youshangdache.model.form.rules.FeeRuleRequest;
import java.math.BigDecimal;
import com.youshangdache.model.vo.rules.FeeRuleResponse;

global com.youshangdache.model.vo.rules.FeeRuleResponse feeRuleResponse;

/**
 * 计价规则
 *
 * 重要：规则里必须通过 setXxx() 修改 global 指向的"同一个对象"，
 * 不能写 feeRuleResponse = FeeRuleResponse.builder()...build() 去整体重新赋值——
 * Drools 不会把 consequence 里对 global 变量的重新赋值传播给其它规则，
 * 会导致后面的规则（例如"计算总金额"）读到的仍是初始的空对象而抛 NPE。
 *
 * 规则执行顺序由 salience 控制：
 *   100 起步价（必须最先执行，确定基准）
 *    50 里程费 / 等候费 / 远途费（在基准上累加）
 *     1 计算总金额（必须最后执行，读取前面算好的各项费用）
 */

/**
1.起步价
    00:00:00-06:59:59  19元(含3公里)
    07:00:00-23:59:59  19元(含5公里)
*/
rule "起步价 00:00:00-06:59:59  19元(含3公里)"
    salience 100
    no-loop true
    when
        $rule:FeeRuleRequest(startTime >= "00:00:00" && startTime <= "06:59:59")
    then
        feeRuleResponse.setBaseDistance(new BigDecimal("3.0"));
        feeRuleResponse.setBaseDistanceFee(new BigDecimal("19.0"));
        feeRuleResponse.setExceedDistance(new BigDecimal("0.0"));
        feeRuleResponse.setExceedDistancePrice(new BigDecimal("4.0"));
end

rule "起步价 07:00:00-23:59:59  19元(含5公里)"
    salience 100
    no-loop true
    when
        $rule:FeeRuleRequest(startTime >= "07:00:00" && startTime <= "23:59:59")
    then
        feeRuleResponse.setBaseDistance(new BigDecimal("5.0"));
        feeRuleResponse.setBaseDistanceFee(new BigDecimal("19.0"));
        feeRuleResponse.setExceedDistance(new BigDecimal("0.0"));
        feeRuleResponse.setExceedDistancePrice(new BigDecimal("3.0"));
end

/**
2.里程费
    超出起步里程后开始计算
    00:00:00-06:59:59   4元/1公里
    07:00:00-23:59:59   3元/1公里
*/
rule "里程费 00:00:00-06:59:59 4元/1公里"
    salience 50
    no-loop true
    when
        $rule:FeeRuleRequest(
            startTime >= "00:00:00"
            && startTime <= "06:59:59"
            && distance.compareTo(new BigDecimal("3.0")) > 0
        )
    then
        feeRuleResponse.setExceedDistance($rule.getDistance().subtract(new BigDecimal("3.0")));
        feeRuleResponse.setExceedDistancePrice(new BigDecimal("4.0"));
end

rule "里程费 07:00:00-23:59:59 3元/1公里"
    salience 50
    no-loop true
    when
        $rule:FeeRuleRequest(
            startTime >= "07:00:00"
            && startTime <= "23:59:59"
            && distance.compareTo(new BigDecimal("5.0")) > 0
        )
    then
        feeRuleResponse.setExceedDistance($rule.getDistance().subtract(new BigDecimal("5.0")));
        feeRuleResponse.setExceedDistancePrice(new BigDecimal("3.0"));
end

/**
3.等候费
    等候10分钟后  1元/1分钟
*/
rule "等候费 等候10分钟后 1元/1分钟"
    salience 50
    no-loop true
    when
        $rule:FeeRuleRequest(waitMinute != null && waitMinute > 10)
    then
        feeRuleResponse.setBaseWaitMinute(10);
        feeRuleResponse.setExceedWaitMinute($rule.getWaitMinute() - 10);
        feeRuleResponse.setExceedWaitMinutePrice(BigDecimal.ONE);
end

rule "无等候费"
    salience 50
    no-loop true
    when
        $rule:FeeRuleRequest(waitMinute == null || waitMinute <= 10)
    then
        feeRuleResponse.setBaseWaitMinute(10);
        feeRuleResponse.setExceedWaitMinute(0);
        feeRuleResponse.setExceedWaitMinutePrice(BigDecimal.ONE);
end

/**
4.远途费
    订单行程超出12公里后每公里1元
*/
rule "远途费 订单行程超出12公里后每公里1元"
    salience 50
    no-loop true
    when
        $rule:FeeRuleRequest(distance.compareTo(new BigDecimal("12.0")) > 0)
    then
        feeRuleResponse.setBaseLongDistance(new BigDecimal("12.0"));
        feeRuleResponse.setExceedLongDistance($rule.getDistance().subtract(new BigDecimal("12.0")));
        feeRuleResponse.setExceedLongDistancePrice(BigDecimal.ONE);
end

rule "无远途费"
    salience 50
    no-loop true
    when
        $rule:FeeRuleRequest(distance.compareTo(new BigDecimal("12.0")) <= 0)
    then
        feeRuleResponse.setBaseLongDistance(new BigDecimal("12.0"));
        feeRuleResponse.setExceedLongDistance(BigDecimal.ZERO);
        feeRuleResponse.setExceedLongDistancePrice(BigDecimal.ZERO);
end

/**
5.计算总金额
    订单总金额 = 基础里程费 + 超出基础里程的费 + 等候费 + 远程费
*/
rule "计算总金额"
    salience 1
    no-loop true
    when
        $rule:FeeRuleRequest(distance.compareTo(new BigDecimal("0.0")) > 0)
    then
        BigDecimal distanceFee = feeRuleResponse.getBaseDistanceFee()
                                    .add(feeRuleResponse.getExceedDistance()
                                                .multiply(feeRuleResponse.getExceedDistancePrice())
                                    );
        BigDecimal waitFee = new BigDecimal(feeRuleResponse.getExceedWaitMinute())
                                .multiply(feeRuleResponse.getExceedWaitMinutePrice());
        BigDecimal longDistanceFee = feeRuleResponse.getExceedLongDistance()
                                        .multiply(feeRuleResponse.getExceedLongDistancePrice());
        BigDecimal totalAmount = distanceFee.add(waitFee).add(longDistanceFee);
        feeRuleResponse.setDistanceFee(distanceFee);
        feeRuleResponse.setWaitFee(waitFee);
        feeRuleResponse.setLongDistanceFee(longDistanceFee);
        feeRuleResponse.setTotalAmount(totalAmount);
end
